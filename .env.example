# Copy to .env; `make dev` exports these. Never commit .env.

# Entra mode
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URL=http://localhost:5173/auth/callback
ALLOWED_GROUP_ID=

# Comma-separated go-mssqldb URLs (no credentials in Entra mode)
SQL_SERVERS=sqlserver://sql1.internal:1433?encrypt=true

# Dev mode instead of Entra: uncomment DEV_USER, remove the Entra vars above,
# and put a SQL login in SQL_SERVERS.
#DEV_USER=dev
#SQL_SERVERS=sqlserver://sa:Dev_Passw0rd@localhost:1433?trustservercertificate=true

#LISTEN_ADDR=:8080

# Container CLI for `make image` / `make run` (docker or podman)
#CONTAINER=podman
